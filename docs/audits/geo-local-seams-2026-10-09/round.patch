+    monkeypatch.setattr(asyncio, "sleep", no_delay)
+
+    with llm.call_budget(0.01), pytest.raises(llm.LLMError) as caught:
+        _run(content.generate(question="介绍示例公司"))
+    assert caught.value.code == "CONTENT_DEADLINE_EXCEEDED"
+    assert calls == 1
