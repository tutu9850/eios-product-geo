# EIOS GEO — 环境变量模板
# 复制为 apps/api/.env 并填入实际值

# 国内 6 引擎 API Key（OpenAI 兼容；P0 实测引擎时按需填）
DEEPSEEK_API_KEY=
KIMI_API_KEY=
DOUBAO_API_KEY=
WENXIN_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=

# Kernel 接入（P3 阶段使用）
KERNEL_API_URL=http://localhost:8000

# LLM（内容生成用，OpenAI 兼容；DeepSeek 官方或任意兼容端点）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# GEO 模型配置来源：优先从 Builder 设置（db.json geoModel）拉取，拿不到才回退上面的 .env
BUILDER_GEO_MODEL_URL=http://localhost:3001/api/geo/model

# EIOS 产品门（GEO-01B）：on 时暴露冻结的 /api/product/geo/*（映射到既有 v1 use case）。
# 默认 off——未完成 GEO-03 身份迁移前，legacy 部署不得静默长出第二个未认证命名空间。
GEO_PRODUCT_DOOR=off
